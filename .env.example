APP_NAME=WhatsApp AI Assistant
APP_VERSION=0.1.0
APP_DESCRIPTION=WhatsApp-first AI ordering assistant
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tiffin_ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_SIGNATURE_VERIFICATION_ENABLED=true
META_WABA_ID=
META_WEBHOOK_PUBLIC_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
META_TEST_RECIPIENT_PHONE=
WHATSAPP_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_SIGNATURE_VERIFICATION_ENABLED=true
TWILIO_TRUST_FORWARDED_HEADERS=false

# Admin owner authentication
ADMIN_AUTH_SECRET=replace-with-a-long-random-production-secret
ADMIN_TOKEN_EXPIRE_MINUTES=60
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_NAME=tiffinai_admin
# Keep lax for local same-site development. For a cross-site Railway backend,
# set ADMIN_COOKIE_SAMESITE=none while keeping ADMIN_COOKIE_SECURE=true.
ADMIN_COOKIE_SAMESITE=lax
BUSINESS_TIMEZONE=Asia/Karachi
ADMIN_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WHATSAPP_OUTBOUND_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
